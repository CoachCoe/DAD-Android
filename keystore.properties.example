# Release signing credentials. Copy this file to keystore.properties (gitignored)
# and fill in the four values before building a release AAB/APK.
#
# Generate an upload keystore once (keep the .jks file and these values safe and
# backed up -- losing them after the app is published means a Play key-reset):
#
#   keytool -genkeypair -v \
#     -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias dad-upload
#
# storeFile is resolved relative to the app/ module directory.

storeFile=../upload-keystore.jks
storePassword=CHANGEME
keyAlias=dad-upload
keyPassword=CHANGEME
